# Copy to .env.local and adjust. Vite only exposes vars prefixed with VITE_.

# RPC endpoints -----------------------------------------------------------
# Local Anvil node (chain id 31337), e.g. `anvil` default.
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
# Sepolia (chain id 11155111) goes through the same-origin proxy at /api/rpc
# (server/rpcProxy.ts): the Vite dev server locally, the Vercel function
# api/rpc.ts in production. The proxy forwards to NOWNodes
# (https://docs.nownodes.io/nodeapis/) when this key is set, otherwise to a
# keyless public endpoint. Deliberately NOT prefixed with VITE_: it is read
# server-side only and never compiled into the browser bundle.
NOWNODES_API_KEY=
# Optional: send the proxy somewhere other than NOWNodes/public (server-side).
# RPC_UPSTREAM_URL=
# Optional: bypass the proxy entirely, e.g. on a static host with no /api.
# VITE_TESTNET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Default NDimPool contract address per network --------------------------
# Optional: if unset, use the in-app "Pool address" field instead (persisted
# in localStorage per-network), no rebuild required.
VITE_POOL_ADDRESS_31337=
VITE_POOL_ADDRESS_11155111=
