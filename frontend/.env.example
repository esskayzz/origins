# Copy to .env.local and adjust. Vite only exposes vars prefixed with VITE_.

# RPC endpoints -----------------------------------------------------------
# Local Anvil node (chain id 31337), e.g. `anvil` default.
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
# Public testnet RPC (chain id 11155111 / Sepolia). Swap for your own
# provider (Alchemy/Infura/etc.) if the public endpoint is rate-limited.
VITE_TESTNET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Default NDimPool contract address per network --------------------------
# Optional: if unset, use the in-app "Pool address" field instead (persisted
# in localStorage per-network), no rebuild required.
VITE_POOL_ADDRESS_31337=
VITE_POOL_ADDRESS_11155111=
